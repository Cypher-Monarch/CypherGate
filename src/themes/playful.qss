/* ────────────────────────────────────────────────────────
   CypherGate — Playful Theme
   ──────────────────────────────────────────────────────── */


/* ────────────────────────────────────────────────────────
   Base
   ──────────────────────────────────────────────────────── */

QWidget#mainWindow {
    background-color: #101014;
    color: #e8e8ee;

    font-family: "Noto Sans";
    font-size: 14px;
}

QWidget {
    background-color: #181825;
    color: #cdd6f4;
}

QLabel {
    color: #e8e8ee;
    background-color: transparent;
}


/* ────────────────────────────────────────────────────────
   Title Bar
   ──────────────────────────────────────────────────────── */

QWidget#titleBar {
    background-color: transparent;
}

QLabel#titleLabel {
    background: transparent;
    color: #cba6f7;

    font-size: 15px;
    font-weight: bold;
}

QPushButton#minimizeButton,
QPushButton#closeButton {
    background: transparent;
    color: #cba6f7;

    border: none;
    border-radius: 8px;

    font-size: 16px;
}

QPushButton#minimizeButton:hover,
QPushButton#closeButton:hover {
    background-color: #313244;
}

QPushButton#closeButton:hover {
    color: #f38ba8;
}


/* ────────────────────────────────────────────────────────
   Headings
   ──────────────────────────────────────────────────────── */

QLabel#headingLabel {
    background: transparent;
    color: #cba6f7;

    font-size: 22px;
    font-weight: bold;
}

QLabel#animLabel {
    background: transparent;
    color: #cba6f7;
}


/* ────────────────────────────────────────────────────────
   Country Dropdown
   ──────────────────────────────────────────────────────── */

QComboBox {
    combobox-popup: 0;

    background-color: #181825;
    color: #cdd6f4;

    border: 1px solid #313244;
    border-radius: 8px;

    padding: 6px 10px;
}

QComboBox:hover {
    border-color: #cba6f7;
}

QComboBox:focus {
    border-color: #cba6f7;
}

QComboBox::drop-down {
    width: 28px;

    border: none;
}

QListView {
    background-color: #181825;
    color: #cdd6f4;

    border: 1px solid #313244;
    outline: none;
}

QListView::item {
    background-color: #181825;
    color: #cdd6f4;

    padding: 6px 8px;
}

QListView::item:hover {
    background-color: #313244;
}

QListView::item:selected {
    background-color: #cba6f7;
    color: #11111b;
}


/* ────────────────────────────────────────────────────────
   Server Table
   ──────────────────────────────────────────────────────── */

QTableCornerButton::section {
    background-color: #181825;
    border: none;
}

QTableWidget#serverTable {
    background-color: #11111b;
    alternate-background-color: #181825;

    border: 1px solid #313244;
    border-radius: 12px;

    gridline-color: #313244;
}

QTableWidget#serverTable::item {
    padding: 8px;
    color: #cba6f7;
}

QTableWidget#serverTable::item:selected {
    background-color: #cba6f7;
    color: #11111b;
}

QHeaderView {
    background-color: #11111b;
}

QHeaderView::section {
    background-color: #181825;
    color: #cba6f7;

    padding: 8px;
    border: none;

    font-weight: bold;
}


/* ────────────────────────────────────────────────────────
   Main Buttons
   ──────────────────────────────────────────────────────── */

QPushButton {
    background-color: #cba6f7;
    color: #11111b;

    border: none;
    border-radius: 12px;

    padding: 10px 18px;

    font-weight: bold;
}

QPushButton:hover {
    background-color: #b4befe;
}

QPushButton:pressed {
    background-color: #89b4fa;
}

QPushButton:disabled {
    background-color: #313244;
    color: #6c7086;
}


/* ────────────────────────────────────────────────────────
   Individual Buttons
   ──────────────────────────────────────────────────────── */

QPushButton#refreshButton,
QPushButton#dashboardCopyDiagnosticsButton,
QPushButton#dashboardLogsButton,
QPushButton#errorLogsButton,
QPushButton#logsCopyButton,
QPushButton#logsBackButton {
    background-color: #89b4fa;
}

QPushButton#connectButton {
    background-color: #a6e3a1;
}

QPushButton#disconnectButton {
    background-color: #f38ba8;
}

QPushButton#autoConnectButton {
    background-color: #fab387;
}

QPushButton#cancelButton {
    background-color: #1e1e2e;
    color: #f9e2af;

    border: 1px solid #f9e2af;
    border-radius: 16px;
}

QPushButton#cancelButton:hover {
    background-color: #313244;
}


/* ────────────────────────────────────────────────────────
   Status
   ──────────────────────────────────────────────────────── */

QLabel#statusLabel {
    color: #a6e3a1;

    font-size: 14px;
    font-weight: bold;
}


/* ────────────────────────────────────────────────────────
   Scrollbars
   ──────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background-color: #11111b;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #cba6f7;
}


/* ────────────────────────────────────────────────────────
   Tooltips
   ──────────────────────────────────────────────────────── */

QToolTip {
    background-color: #181825;
    color: #cdd6f4;

    border: 1px solid #cba6f7;
    border-radius: 8px;

    padding: 6px;
}

/* ────────────────────────────────────────────────────────
   Connected Dashboard
   ──────────────────────────────────────────────────────── */



QFrame#dashboardCard {
    background-color: rgba(128, 128, 128, 0.08);
    border: 1px solid palette(mid);
    border-radius: 8px;
}

QLabel#dashboardHeroIcon,
QLabel#dashboardStatus,
QLabel#dashboardCountry,
QLabel#dashboardHostname {
    background: transparent;
}

QLabel#dashboardStatus {
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#dashboardCountry {
    font-size: 25px;
    font-weight: bold;
}

QLabel#dashboardHostname {
    font-size: 11px;
    color: palette(mid);
}

QLabel#dashboardMetricHeading {
    font-size: 9px;
    font-weight: bold;
    color: palette(mid);
}

QLabel#dashboardMetricValue {
    font-size: 16px;
    font-weight: bold;
}

QLabel#dashboardFooter,
QLabel#logsStatusLabel {
    font-size: 10px;
    color: palette(mid);
}


/* Log Viewer */

/* Theme-aware dashboard and log viewer overrides */
QFrame#dashboardHero {
    color: #CBA6F7;
}

QPushButton#refreshButton,
QPushButton#dashboardCopyDiagnosticsButton,
QPushButton#dashboardLogsButton,
QPushButton#errorLogsButton,
QPushButton#logsCopyButton,
QPushButton#logsBackButton {
    background-color: #cba6f7;
    color: #11111b;
    border: 1px solid #CBA6F7;
}

QPushButton#refreshButton:hover,
QPushButton#dashboardCopyDiagnosticsButton:hover,
QPushButton#dashboardLogsButton:hover,
QPushButton#errorLogsButton:hover,
QPushButton#logsCopyButton:hover,
QPushButton#logsBackButton:hover {
    background-color: #b4befe;
    border-color: #CBA6F7;
}

QPlainTextEdit#logsOutput {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #CBA6F7;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #CBA6F7;
    selection-color: #11111b;
    font-family: monospace;
}
