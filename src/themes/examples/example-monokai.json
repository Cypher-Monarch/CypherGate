{
    "config_version": 1,
    "theme": {
        "mode": "builtin",
        "name": "monokai",
        "path": null
    },
    "icons": {
        "size": {
            "cancel": 20,
            "refresh": 20,
            "connect": 20,
            "disconnect": 20,
            "auto_connect": 20,
            "show": 20,
            "exit": 20,
            "tray": {
                "cancel": 20,
                "connect": 20,
                "disconnect": 20,
                "show": 20,
                "exit": 20
            }
        },
        "color": {
            "cancel": "#F92672",
            "refresh": "#F8F8F2",
            "connect": "#272822",
            "disconnect": "#F92672",
            "auto_connect": "#E6DB74",
            "show": "#A6E22E",
            "exit": "#F92672",
            "tray": {
                "cancel": "#F92672",
                "connect": "#272822",
                "disconnect": "#F92672",
                "show": "#A6E22E",
                "exit": "#F92672"
            }
        }
    },
    "widgets": {
        "spinner": {
            "size": 40,
            "color": "#A6E22E",
            "thickness": 3,
            "fps": 60,
            "rotation_speed": 360
        },
        "table": {
            "columns": [
                "country",
                "ping",
                "speed",
                "users"
            ],
            "sort_by": "ping",
            "sort_order": "ascending"
        }
    },
    "application": {
        "minimize_to_tray": false,
        "notifications": false,
        "status_update_interval": 500,
        "use_custom_fonts": false
    },
    "vpn": {
        "connection_timeout": 30,
        "default_country": null
    }
}
