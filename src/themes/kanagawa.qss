/* CypherGate — Kanagawa */

QWidget#mainWindow {
    background-color: #1F1F28;
    color: #DCD7BA;
    font-family: "JetBrains Mono";
    font-size: 14px;
}

QWidget {
    background-color: #16161D;
    color: #DCD7BA;
    font-family: "JetBrains Mono";
}

QLabel {
    background: transparent;
    color: #DCD7BA;
}

/* Title bar */

QWidget#titleBar {
    background-color: transparent;
}

QLabel#titleLabel {
    background: transparent;
    color: #DCD7BA;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#minimizeButton,
QPushButton#closeButton {
    background: transparent;
    color: #727169;
    border: none;
    border-radius: 5px;
    font-size: 16px;
}

QPushButton#minimizeButton:hover,
QPushButton#closeButton:hover {
    background-color: #2A2A37;
    color: #DCD7BA;
}

QPushButton#closeButton:hover {
    color: #C34043;
}

/* Headings */

QLabel#headingLabel {
    background: transparent;
    color: #DCD7BA;
    font-size: 22px;
    font-weight: bold;
}

QLabel#animLabel {
    background: transparent;
    color: #7E9CD8;
}

QLabel#statusLabel {
    color: #98BB6C;
    font-size: 14px;
    font-weight: bold;
}

/* Country dropdown */

QComboBox {
    combobox-popup: 0;
    background-color: #2A2A37;
    color: #DCD7BA;
    border: 1px solid #363646;
    border-radius: 5px;
    padding: 6px 10px;
}

QComboBox:hover {
    border-color: #727169;
}

QComboBox:focus {
    border-color: #7E9CD8;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
    border-left: 1px solid #363646;
}

QListView {
    background-color: #16161D;
    color: #DCD7BA;
    border: 1px solid #363646;
    outline: none;
}

QListView::item {
    background-color: #16161D;
    color: #DCD7BA;
    padding: 6px 8px;
}

QListView::item:hover {
    background-color: #2A2A37;
}

QListView::item:selected {
    background-color: #363646;
    color: #DCD7BA;
}

/* Server table */

QTableCornerButton::section {
    background-color: #16161D;
    border: none;
}

QTableWidget#serverTable {
    background-color: #1F1F28;
    alternate-background-color: #16161D;
    color: #DCD7BA;
    border: 1px solid #363646;
    border-radius: 6px;
    gridline-color: #363646;
    selection-background-color: #363646;
    selection-color: #DCD7BA;
    outline: none;
}

QTableWidget#serverTable::item {
    background-color: transparent;
    color: #DCD7BA;
    padding: 8px;
    border: none;
}

QTableWidget#serverTable::item:hover {
    background-color: #2A2A37;
}

QTableWidget#serverTable::item:selected {
    background-color: #7E9CD8;
    color: #1F1F28;
    font-weight: bold;
}

QHeaderView {
    background-color: #1F1F28;
}

QHeaderView::section {
    background-color: #2A2A37;
    color: #DCD7BA;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #363646;
    font-weight: bold;
}

/* Buttons */

QPushButton {
    background-color: #2A2A37;
    color: #DCD7BA;
    border: 1px solid #363646;
    border-radius: 6px;
    padding: 9px 17px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #363646;
    border-color: #7E9CD8;
}

QPushButton:pressed {
    background-color: #16161D;
}

QPushButton:disabled {
    background-color: #16161D;
    color: #727169;
    border-color: #363646;
}

QPushButton#refreshButton {
    background-color: #2A2A37;
    color: #DCD7BA;
    border-color: #363646;
}

QPushButton#refreshButton:hover {
    color: #7E9CD8;
}

QPushButton#connectButton {
    background-color: #98BB6C;
    color: #1F1F28;
    border-color: #98BB6C;
}

QPushButton#connectButton:hover {
    background-color: #98BB6C;
}

QPushButton#disconnectButton {
    background-color: #2A2A37;
    color: #C34043;
    border-color: #363646;
}

QPushButton#disconnectButton:hover {
    background-color: #2A2A37;
    border-color: #C34043;
}

QPushButton#autoConnectButton {
    background-color: #2A2A37;
    color: #DCD7BA;
    border-color: #363646;
}

QPushButton#autoConnectButton:hover {
    color: #E6C384;
    border-color: #E6C384;
}

QPushButton#cancelButton {
    background-color: #2A2A37;
    color: #C34043;
    border: 1px solid #363646;
    border-radius: 16px;
}

QPushButton#cancelButton:hover {
    border-color: #C34043;
}

/* Scrollbar */

QScrollBar:vertical {
    background-color: #1F1F28;
    width: 9px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #2A2A37;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #363646;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Tooltips */

QToolTip {
    background-color: #2A2A37;
    color: #DCD7BA;
    border: 1px solid #363646;
    border-radius: 4px;
    padding: 6px;
}
